# Public Supabase browser configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Restricted quiz_runner Session pooler connection string used by the web app.
# Never commit the real role password.
DATABASE_URL=postgresql://quiz_runner.your-project-ref:YOUR_ROLE_PASSWORD@your-pooler-host:5432/postgres?sslmode=require

# AI API used by the RAG SQL generator. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5
